# =================================================================
# SIH 26192: FLASH FLOOD EARLY WARNING SYSTEM - CONFIGURATION TEMPLATE (.env.example)
# =================================================================
# NOTE: This is the PUBLIC template file.
# Copy this file to .env and fill in your private API keys.

# 1. Weather & Rainfall API Keys (Optional for live external forecasts)
OPENWEATHER_API_KEY=
IMD_API_TOKEN=

# 2. Mapbox / CartoDB / Basemap Token (Optional - Default uses free direct basemaps)
MAPBOX_ACCESS_TOKEN=
CARTODB_API_KEY=
VITE_MAPS_API_KEY=

# 3. Emergency SMS Gateway (Fast2SMS for India / Twilio for Global)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 4. Aapda Mitra AI Assistant (OpenRouter Free Model Key)
# Default model: google/gemma-4-26b-a4b-it:free
# If empty, Aapda Mitra AI automatically uses the zero-cost offline deterministic engine.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# 5. Google Earth Engine (WorldPop 100m & Copernicus 30m DEM Satellite Analytics)
EARTH_ENGINE_PROJECT_ID=vigil-flood-510101
EARTH_ENGINE_SERVICE_ACCOUNT=vigil-flood-sa@vigil-flood-510101.iam.gserviceaccount.com
# For Local: file path to your service account key json
GOOGLE_APPLICATION_CREDENTIALS=./vigil-flood-510101-29471e45cf7b.json
# For Render / Cloud: You can optionally paste the raw JSON string directly into this env var:
# EARTH_ENGINE_SERVICE_ACCOUNT_KEY_JSON={"type": "service_account", ...}

# 6. Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

