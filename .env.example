# =================================================================
# SIH 26192: FLASH FLOOD EARLY WARNING SYSTEM - CONFIGURATION (.env)
# =================================================================
# NOTE: The dashboard works 100% out of the box with free basemaps.
# If you obtain API keys for real weather/SMS services, paste them below:

# 1. Weather & Rainfall API Keys (Optional for live real-world external forecasts)
OPENWEATHER_API_KEY=
IMD_API_TOKEN=

# 2. Mapbox / CartoDB Token (Optional - Default uses free Esri/OSM/Topo basemaps)
MAPBOX_ACCESS_TOKEN=
CARTODB_API_KEY=

# 3. Emergency SMS / WhatsApp Gateway (Optional for real telecommunication dispatch)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 4. Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
